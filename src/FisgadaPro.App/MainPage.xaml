<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FisgadaPro.App.MainPage" Title="Fisgada Pro" BackgroundColor="#F2F6F4">
<ScrollView><VerticalStackLayout Padding="20" Spacing="14">
<Label Text="Fisgada Pro" FontSize="30" FontAttributes="Bold" />
<Label Text="Área do associado - gestão social" />
<Label x:Name="Mensagem" TextColor="#9C281B" />
<VerticalStackLayout x:Name="LoginPainel" Spacing="12">
<Label Text="Endereço da API para teste local" /><Entry x:Name="ApiUrl" Placeholder="http://IP-DO-COMPUTADOR:5187" Keyboard="Url" />
<Entry x:Name="Email" Placeholder="E-mail" Keyboard="Email" MaxLength="254" /><Entry x:Name="Senha" Placeholder="Senha" IsPassword="True" MaxLength="256" />
<Button x:Name="EntrarBotao" Text="Entrar" Clicked="AoEntrar" />
</VerticalStackLayout>
<VerticalStackLayout x:Name="ContaPainel" IsVisible="False" Spacing="14">
<Label x:Name="Nome" FontAttributes="Bold" /><Picker x:Name="ClubesPicker" Title="Clube" ItemDisplayBinding="{Binding Nome}" SelectedIndexChanged="AoSelecionarClube" />
<HorizontalStackLayout Spacing="5"><Button Text="Conta" Clicked="AbrirConta" /><Button Text="Financeiro" Clicked="AbrirFinanceiro" /><Button Text="Agenda" Clicked="AbrirAgenda" /></HorizontalStackLayout>
<HorizontalStackLayout Spacing="5"><Button Text="Eventos" Clicked="AbrirEventos" /><Button Text="Solicitações" Clicked="AbrirSolicitacoes" /></HorizontalStackLayout>
<VerticalStackLayout x:Name="Conteudo" Spacing="14" />
<Button x:Name="SairBotao" Text="Sair" Clicked="AoSair" />
</VerticalStackLayout>
<Label Text="Desenvolvimento: dados iniciais fictícios. Boleto bancário depende de integração ainda não configurada." FontSize="12" />
</VerticalStackLayout></ScrollView>
</ContentPage>

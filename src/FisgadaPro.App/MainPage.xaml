<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FisgadaPro.App.MainPage" Title="Fisgada Pro" BackgroundColor="#F2F6F4">
<ScrollView><VerticalStackLayout Padding="24" Spacing="18">
<Label Text="Fisgada Pro" FontSize="32" FontAttributes="Bold" />
<Label Text="Área do associado · demonstração" />
<Label x:Name="Mensagem" TextColor="#9C281B" />
<VerticalStackLayout x:Name="LoginPainel" Spacing="12">
    <Label Text="Endereço da API para teste local" />
    <Entry x:Name="ApiUrl" Placeholder="http://IP-DO-COMPUTADOR:5187" Keyboard="Url" />
    <Entry x:Name="Email" Placeholder="E-mail" Keyboard="Email" MaxLength="254" />
    <Entry x:Name="Senha" Placeholder="Senha" IsPassword="True" MaxLength="256" />
    <Button x:Name="EntrarBotao" Text="Entrar" Clicked="AoEntrar" />
</VerticalStackLayout>
<VerticalStackLayout x:Name="ContaPainel" IsVisible="False" Spacing="16">
    <Label x:Name="Nome" FontAttributes="Bold" />
    <Label Text="Selecione seu clube" />
    <Picker x:Name="ClubesPicker" Title="Clube" ItemDisplayBinding="{Binding Nome}" SelectedIndexChanged="AoSelecionarClube" />
    <Label Text="Minha conta e gastos familiares" FontSize="22" />
    <VerticalStackLayout x:Name="ExtratoPainel" Spacing="12" />
    <Button x:Name="SairBotao" Text="Sair" Clicked="AoSair" />
</VerticalStackLayout>
<Label Text="Dados fictícios. Sem emissão de cobranças. Familiares não têm taxa fixa adicional; seus gastos aparecem na conta do titular." FontSize="13" />
</VerticalStackLayout></ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FisgadaPro.App.MainPage" Title="Fisgada Pro" BackgroundColor="#F2F6F4">
<ScrollView><VerticalStackLayout Padding="24" Spacing="18">
    <Label Text="Fisgada Pro" FontSize="32" FontAttributes="Bold" />
    <Label Text="Demonstração local · dados fictícios" />
    <Label Text="Selecione um clube" FontAttributes="Bold" />
    <Picker x:Name="ClubesPicker" Title="Clube" ItemDisplayBinding="{Binding Nome}" SelectedIndexChanged="AoSelecionarClube" />
    <Label Text="Associados" FontSize="23" FontAttributes="Bold" />
    <VerticalStackLayout x:Name="ListaAssociados" Spacing="12" />
    <Label Text="Familiares sem taxa fixa adicional. Consumos são atribuídos ao titular, identificando quem fez a despesa." />
    <Label Text="Sem login, cadastro persistente ou emissão de cobranças nesta versão. A conexão com a API será implementada após autenticação." FontSize="13" />
</VerticalStackLayout></ScrollView>
</ContentPage>

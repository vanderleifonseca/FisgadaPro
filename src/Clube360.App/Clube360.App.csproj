<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Clube360.App</RootNamespace>
    <UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <ApplicationTitle>Clube360</ApplicationTitle>
    <!-- Keep the installed Android package identity so updates preserve app data. -->
    <ApplicationId>br.com.fisgadapro.app</ApplicationId>
    <ApplicationDisplayVersion>0.3.1</ApplicationDisplayVersion><ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'"><AndroidManifest>Platforms/Android/AndroidManifest.Debug.xml</AndroidManifest></PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#103C32" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#103C32" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../Clube360.Contracts/Clube360.Contracts.csproj" />
  </ItemGroup>
</Project>

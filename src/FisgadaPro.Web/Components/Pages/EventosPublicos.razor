@page "/eventos-publicos"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using FisgadaPro.Contracts
@using System.Net.Http.Json
@inject IHttpClientFactory Clients
<PageTitle>Eventos públicos - Fisgada Pro</PageTitle>
<h1>Eventos abertos ao público</h1><p>Ambiente de desenvolvimento. Não efetue pagamentos reais pelos dados de exemplo.</p><a href="/entrar">Acesso dos associados</a>
@if(_mensagem is not null){<p role="status">@_mensagem</p>}
@foreach(var e in _eventos){<article><h2>@e.Nome</h2><p>@e.Descricao</p><p>@Horario(e.Inicio).ToString("dd/MM/yyyy HH:mm") a @Horario(e.Fim).ToString("dd/MM/yyyy HH:mm") · @e.ValorInscricao.ToString("C")</p><button @onclick="()=>_evento=e.Id">Inscrever-me</button></article>}
@if(_evento is not null){<h2>Inscrição de visitante</h2><label>Nome<input @bind="_nome" /></label><label>CPF<input @bind="_cpf" /></label><label>E-mail<input @bind="_email" /></label><button @onclick="Enviar" disabled="@_ocupado">Confirmar inscrição de demonstração</button>}
@code{
private static DateTimeOffset Horario(DateTimeOffset valor)=>TimeZoneInfo.ConvertTime(valor,TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo"));
private List<EventoDto> _eventos=[];private string? _mensagem;private Guid? _evento;private string _nome="",_cpf="",_email="";private bool _ocupado;
protected override async Task OnInitializedAsync(){try{using var c=Clients.CreateClient("api");_eventos=await c.GetFromJsonAsync<List<EventoDto>>("/api/v1/eventos-publicos")??[];}catch(HttpRequestException){_mensagem="API indisponível.";}}
private async Task Enviar(){if(_ocupado||_evento is null)return;_ocupado=true;try{using var c=Clients.CreateClient("api");using var r=await c.PostAsJsonAsync($"/api/v1/eventos-publicos/{_evento}/inscricoes",new VisitanteRequest(_nome,_cpf,_email));_mensagem=r.IsSuccessStatusCode?"Inscrição registrada. Integração bancária ainda não configurada.":"Não foi possível inscrever. Confira os dados, a inscrição anterior ou aguarde um minuto.";}catch(HttpRequestException){_mensagem="API indisponível.";}finally{_ocupado=false;}}
}

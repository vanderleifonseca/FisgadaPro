@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using FisgadaPro.Contracts
@using FisgadaPro.Web.Services
@inject ApiAutenticada Api
<PageTitle>Fisgada Pro</PageTitle>
@if (_erro is not null) { <div class="aviso" role="alert">@_erro <a href="/entrar">Entrar novamente</a></div> }
else if (_sessao is null) { <p>Carregando sua conta...</p> }
else {
<h1>@(_sessao.Perfil == "Socio" ? "Área do associado" : _sessao.Perfil == "Plataforma" ? "Administração da plataforma" : "Administração do clube")</h1>
<p>Bem-vindo, @_sessao.Nome.</p>
<div class="aviso">Demonstração com login. Dados fictícios, sem emissão de cobranças.</div>
<form method="post" action="/autenticacao/sair"><AntiforgeryToken /><button type="submit">Sair</button></form>
<section class="selecao"><label for="clube">Clube</label>
<select id="clube" value="@_clube" @onchange="TrocarClube" disabled="@_ocupado">
@foreach (var c in _sessao.Clubes) { <option value="@c.Id">@c.Nome</option> }
</select></section>
@if (_sessao.Perfil == "Plataforma") { <p>A plataforma consulta os clubes cadastrados. A operação financeira pertence a cada clube. Cadastro de novos clubes será implementado depois.</p> }
@if (_sessao.Perfil == "Administrador") {
<h2>Associados do seu clube</h2>
<div class="tabela"><table><thead><tr><th>Nome</th><th>Categoria</th><th>Extrato</th></tr></thead>
<tbody>@foreach (var p in _pessoas) {
<tr><td>@p.Nome</td><td>@p.Categoria @(p.Atleta ? "· Atleta" : "")</td><td>
@if (p.TitularId is null) { <button disabled="@_ocupado" @onclick="() => Consultar(p.Id)">Consultar prévia</button> }
else { <span>Na conta do titular</span> }
</td></tr>
}</tbody></table></div>
}
@if (_extrato is not null) {
<section class="extrato"><h2>Conta de @_extrato.Titular</h2>
<p>Mensalidade: @_extrato.Mensalidade.ToString("C")</p>
<p>Taxa fixa adicional por familiar: R$ 0,00</p>
<div class="tabela"><table><thead><tr><th>Quem fez a despesa</th><th>Descrição</th><th>Valor</th></tr></thead>
<tbody>@foreach (var d in _extrato.Despesas) { <tr><td>@d.Consumidor</td><td>@d.Descricao</td><td>@d.Valor.ToString("C")</td></tr> }</tbody></table></div>
<p class="total">Total demonstrativo: @_extrato.Total.ToString("C")</p></section>
}
}
@code {
    private SessaoDto? _sessao;
    private Guid _clube;
    private IReadOnlyList<AssociadoDto> _pessoas = [];
    private ExtratoDto? _extrato;
    private string? _erro;
    private bool _ocupado;
    protected override async Task OnInitializedAsync() {
        try {
            _sessao = await Api.Get<SessaoDto>("/api/v1/sessao");
            _clube = _sessao.Clubes.First().Id;
            await Carregar();
        } catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _erro = "Sessão expirada ou API indisponível."; }
    }
    private async Task TrocarClube(ChangeEventArgs e) {
        if (_ocupado || !Guid.TryParse(e.Value?.ToString(), out var id) || _sessao!.Clubes.All(c => c.Id != id)) return;
        _clube = id; await Carregar();
    }
    private async Task Carregar() {
        _ocupado = true; _extrato = null; _pessoas = [];
        try {
            if (_sessao!.Perfil == "Socio") _extrato = await Api.Get<ExtratoDto>($"/api/v1/clubes/{_clube}/meu-extrato");
            else if (_sessao.Perfil == "Administrador") _pessoas = await Api.Get<IReadOnlyList<AssociadoDto>>($"/api/v1/clubes/{_clube}/associados");
        } catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _erro = "Não foi possível carregar os dados. Entre novamente."; }
        finally { _ocupado = false; }
    }
    private async Task Consultar(Guid id) {
        _ocupado = true;
        try { _extrato = await Api.Get<ExtratoDto>($"/api/v1/clubes/{_clube}/titulares/{id}/extrato"); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _erro = "Não foi possível consultar o extrato."; }
        finally { _ocupado = false; }
    }
}

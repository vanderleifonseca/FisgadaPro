@using Clube360.Contracts
<div class="form-grid">
<label>Nome<input @bind="Modelo.Nome" maxlength="160" /></label>
<label>CPF<input @bind="Modelo.Cpf" maxlength="14" /></label>
<label>Categoria<select @bind="Modelo.Categoria" @bind:after="Ajustar">
@if (!SomenteConvite) { <option>Associado</option><option>Fundador</option><option>Dependente</option> }
<option>Convidado</option><option>Simpatizante</option>
</select></label>
<label>Data de nascimento<input type="date" @bind="Modelo.DataNascimento" /></label>
<label>Endereço<input @bind="Modelo.Endereco" /></label><label>Bairro<input @bind="Modelo.Bairro" /></label>
<label>Cidade<input @bind="Modelo.Cidade" /></label><label>UF<input @bind="Modelo.Uf" maxlength="2" /></label>
<label>Sexo<select @bind="Modelo.Sexo"><option value="">Não informado</option><option>Masculino</option><option>Feminino</option><option>Outro</option></select></label>
<label>Estado civil<input @bind="Modelo.EstadoCivil" maxlength="40" /></label>
<label>Telefone<input @bind="Modelo.Fone" /></label><label>E-mail<input type="email" @bind="Modelo.Email" /></label>
@if (!SomenteConvite) {
<label><input type="checkbox" @bind="Modelo.Ativo" /> Cadastro ativo</label>
<label>Valor mensal específico (opcional)<input type="number" min="0" step="0.01" @bind="Modelo.ValorMensal" disabled="@(Modelo.Categoria == "Dependente")" /></label>
@if (Modelo.Categoria == "Fundador") { <label><input type="checkbox" @bind="Modelo.Isento" /> Isento de mensalidade</label> }
}
@if (Modelo.Categoria == "Dependente") {
<label>Titular<select @bind="Modelo.TitularId"><option value="">Selecione</option>
@foreach(var p in Pessoas.Where(p=>p.Categoria is "Associado" or "Fundador")){<option value="@p.Id">@p.Nome</option>}
</select></label>
<label>Parentesco<select @bind="Modelo.Parentesco"><option value="">Selecione</option>
@foreach(var p in new[]{"Pai","Mae","Filho","Filha","Avo","Avoa","Conjuge"}){<option>@p</option>}
</select></label>
}
</div>
<fieldset><legend>Interesses</legend>
@foreach(var i in new[]{"pesca","caça","comida","bebida"}) { <label class="check"><input type="checkbox" checked="@((Modelo.Interesses??[]).Contains(i))" @onchange="e=>Marcar(i,e)" /> @i</label> }
</fieldset>
@code {
[Parameter,EditorRequired] public AssociadoRequest Modelo {get;set;}=new();
[Parameter] public bool SomenteConvite {get;set;}
[Parameter] public IReadOnlyList<PessoaDto> Pessoas {get;set;}=[];
private void Marcar(string i,ChangeEventArgs e){Modelo.Interesses=((bool)(e.Value??false)?(Modelo.Interesses??[]).Append(i):(Modelo.Interesses??[]).Where(x=>x!=i)).Distinct().ToArray();}
private void Ajustar(){if(Modelo.Categoria!="Fundador")Modelo.Isento=false;if(Modelo.Categoria!="Dependente"){Modelo.TitularId=null;Modelo.Parentesco=null;}else{Modelo.ValorMensal=null;Modelo.Isento=false;}}
}

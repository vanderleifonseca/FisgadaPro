@page "/entrar"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
<PageTitle>Entrar — Clube360</PageTitle>
<h1>Entrar no Clube360</h1>
<p>Use uma conta local configurada pelo responsável. Dados de demonstração.</p>
@if (Erro is not null) { <p role="alert">@(Erro == "api" ? "API indisponível. Verifique se está funcionando." : "Não foi possível entrar. Confira as credenciais ou aguarde um minuto.")</p> }
<form method="post" action="/autenticacao/entrar" class="selecao">
    <AntiforgeryToken />
    <label for="email">E-mail</label><input id="email" name="email" type="email" required autocomplete="username" maxlength="254" />
    <label for="senha">Senha</label><input id="senha" name="senha" type="password" required autocomplete="current-password" maxlength="256" />
    <button type="submit">Entrar</button>
</form>
@code { [SupplyParameterFromQuery(Name = "erro")] public string? Erro { get; set; } }

<p><a href="/eventos-publicos">Consultar eventos abertos ao público</a></p>

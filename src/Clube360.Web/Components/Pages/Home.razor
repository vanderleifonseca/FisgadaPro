@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Clube360.Contracts
@using Clube360.Web.Services
@using Clube360.Web.Components.Shared
@inject ApiAutenticada Api
<PageTitle>Clube360 - Gestão social</PageTitle>
@if(_sessao is null){<h1>Clube360</h1><p>@(_mensagem??"Carregando...")</p><a href="/entrar">Entrar</a>}
else {
<h1>@Titulo</h1><p>@_sessao.Nome · @_sessao.Perfil</p>
<div class="aviso">Versão 0.3.1 de desenvolvimento. Os valores e associados iniciais são exemplos. Os novos registros são salvos localmente.</div>
<form method="post" action="/autenticacao/sair"><AntiforgeryToken /><button type="submit">Sair</button></form>
<section class="selecao"><label for="clube">Clube</label><select id="clube" value="@_clube" @onchange="TrocarClube" disabled="@_ocupado">
@foreach(var c in _clubes){<option value="@c.Id">@c.Nome</option>}
</select></section>
@if(_mensagem is not null){<p class="aviso" role="status">@_mensagem</p>}
<nav class="modulos" aria-label="Módulos">
@foreach(var item in Abas){<button class="@(_aba==item?"ativo":"")" @onclick="()=>_aba=item">@item</button>}
</nav>
@if(_aba=="Resumo"){
<h2>Visão do clube</h2>
<div class="cards"><article><span>Clube</span><strong>@_clubes.FirstOrDefault(c=>c.Id==_clube)?.Nome</strong></article><article><span>Espaços disponíveis</span><strong>@_espacos.Count</strong></article><article><span>Financeiro em aberto</span><strong>@(_financeiro?.Aberto.ToString("C")??"Acesso restrito")</strong></article></div>
<p>Use os módulos para cadastros, eventos, locações, solicitações e financeiro.</p>
@if(_meuCadastro is not null){<p>@_meuCadastro.Associado.Nome · @_meuCadastro.Associado.Categoria · Direito a voto: @(_meuCadastro.Associado.DireitoVoto?"Sim":"Não")</p>
<h3>Dependentes</h3>@foreach(var p in _meuCadastro.Dependentes){<p>@p.Nome · sem taxa fixa adicional</p>}}
}
@if(_aba=="Clubes"&&(_sessao.Perfil is "SuperAdmin" or "Presidente")){
<h2>Cadastro de clubes</h2><button @onclick="EditarClube">Carregar dados do clube selecionado</button>
@if(_sessao.Perfil=="SuperAdmin"){<button @onclick="()=>{_editarClube=null;_novoClube=new();}">Novo clube</button>}
<div class="form-grid">
<label>Nome<input @bind="_novoClube.Nome" /></label><label>Sigla<input @bind="_novoClube.Sigla" /></label>
<label>Endereço<input @bind="_novoClube.Endereco" /></label><label>Bairro<input @bind="_novoClube.Bairro" /></label>
<label>Cidade<input @bind="_novoClube.Cidade" /></label><label>UF<input @bind="_novoClube.Uf" maxlength="2" /></label>
<label>Telefone<input @bind="_novoClube.Fone" /></label><label>E-mail<input @bind="_novoClube.Email" /></label>
<label>Mensalidade padrão<input type="number" min="0" step="0.01" @bind="_novoClube.ValorMensalPadrao" /></label>
</div><button disabled="@_ocupado" @onclick="SalvarClube">Salvar clube</button>
}
@if(_aba=="Associados"&&Gestor){
<h2>Associados e dependentes</h2>
<div class="tabela"><table><thead><tr><th>Nome</th><th>CPF</th><th>Categoria</th><th>Voto</th><th>Ação</th></tr></thead><tbody>
@foreach(var p in _pessoas){<tr><td>@p.Nome</td><td>@p.Cpf</td><td>@p.Categoria</td><td>@(p.DireitoVoto?"Sim":"Não")</td><td><button @onclick="()=>EditarPessoa(p)">Editar</button></td></tr>}
</tbody></table></div>
<h3>@(_editarPessoa is null?"Novo cadastro":"Editar cadastro")</h3><button @onclick="()=>{_editarPessoa=null;_novaPessoa=new();}">Novo associado ou dependente</button><FormularioPessoa Modelo="_novaPessoa" Pessoas="_pessoas" /><button disabled="@_ocupado" @onclick="CriarPessoa">Salvar cadastro</button>
}
@if(_aba=="Agenda"){
<h2>Agenda de eventos e locações</h2><p>Os horários abaixo são exibidos no fuso de Brasília. O servidor confirma a disponibilidade antes de reservar.</p>
<div class="tabela"><table><thead><tr><th>Tipo</th><th>Descrição</th><th>Início</th><th>Término</th><th>Espaço</th></tr></thead><tbody>
@foreach(var x in _agenda){<tr><td>@x.Tipo</td><td>@x.Nome</td><td>@Hora(x.Inicio)</td><td>@Hora(x.Fim)</td><td>@NomeEspaco(x.EspacoId)</td></tr>}
</tbody></table></div>
@if(Gestor){<h3>Cadastrar ou atualizar espaço</h3>
@foreach(var e in _espacos){<p>@e.Nome · @e.TaxaAluguel.ToString("C") <button @onclick="()=>{_editarEspaco=e.Id;_nomeEspaco=e.Nome;_taxa=e.TaxaAluguel;}">Editar taxa</button></p>}<div class="form-grid"><label>Nome<input @bind="_nomeEspaco" /></label><label>Taxa de aluguel<input type="number" min="0" step="0.01" @bind="_taxa" /></label></div><button @onclick="CriarEspaco" disabled="@_ocupado">Salvar espaço</button>}
@if(Socio){<h3>Reservar espaço</h3>
<div class="form-grid"><label>Espaço<select @bind="_espacoReserva"><option value="">Selecione</option>@foreach(var e in _espacos){<option value="@e.Id">@e.Nome · @e.TaxaAluguel.ToString("C")</option>}</select></label>
<label>Finalidade<input @bind="_finalidade" placeholder="Festa, churrasco, feijoada..." /></label>
<label>Início<input type="datetime-local" @bind="_inicioReserva" /></label><label>Término<input type="datetime-local" @bind="_fimReserva" /></label></div>
<p>A taxa do espaço será lançada na conta do titular. Cancelamento permitido até 120 horas antes do início.</p>
<button @onclick="VerificarDisponibilidade">Verificar disponibilidade</button><button disabled="@_ocupado" @onclick="Reservar">Confirmar locação e cobrança</button>}
<h3>@(Socio?"Minhas reservas":"Reservas do clube")</h3>
@foreach(var r in _reservas){<article><p>@NomeEspaco(r.EspacoId) · @Hora(r.Inicio) a @Hora(r.Fim) · @r.Situacao · @r.Valor.ToString("C")</p>
@if(r.Situacao=="Confirmada"&&(Gestor||Socio)){<button disabled="@_ocupado" @onclick="()=>Cancelar(r.Id)">Cancelar reserva</button>}</article>}
}
@if(_aba=="Eventos"){
<h2>Eventos do clube</h2>
@if(Gestor){
<div class="form-grid"><label>Nome<input @bind="_nomeEvento" placeholder="Almoço dia das mães, jantar, café..." /></label>
<label>Descrição<input @bind="_descricaoEvento" /></label><label>Público<select @bind="_publico"><option value="SomenteSocios">Somente sócios</option><option value="Publico">Aberto ao público</option></select></label>
<label>Valor da inscrição<input type="number" min="0" step="0.01" @bind="_valorEvento" /></label>
<label>Início<input type="datetime-local" @bind="_inicioEvento" /></label><label>Término<input type="datetime-local" @bind="_fimEvento" /></label>
<label>Espaço (opcional)<select @bind="_espacoEvento"><option value="">Sem ocupação de espaço</option>@foreach(var e in _espacos){<option value="@e.Id">@e.Nome</option>}</select></label></div>
<button disabled="@_ocupado" @onclick="CriarEvento">Cadastrar evento</button>}
@foreach(var e in _eventos){<article><h3>@e.Nome</h3><p>@e.Descricao</p><p>@Hora(e.Inicio) a @Hora(e.Fim) · @e.Publico · @e.ValorInscricao.ToString("C")</p>
@if(Socio){<button disabled="@_ocupado" @onclick="()=>Inscrever(e.Id)">Inscrever-me</button>}</article>}
@if(Socio&&_meuCadastro?.Associado.Categoria is "Associado" or "Fundador"){
<h3>Indicar convidado ou simpatizante para um evento</h3>
<label>Evento<select @bind="_eventoConvite"><option value="">Selecione</option>@foreach(var e in _eventos){<option value="@e.Id">@e.Nome</option>}</select></label>
<FormularioPessoa Modelo="_convidado" SomenteConvite="true" />
<p>A participação depende da aprovação da administração.</p><button disabled="@_ocupado" @onclick="Convidar">Enviar para aprovação</button>}
<h3>Convites e aprovações</h3>
@foreach(var c in _convites){<article><p>@c.Pessoa.Nome · @c.Pessoa.Categoria · @c.Status</p><p>@c.Observacao</p>
@if(Gestor&&c.Status=="Pendente"){<button disabled="@_ocupado" @onclick="()=>Decidir(c.Id,true)">Aprovar participação</button><button disabled="@_ocupado" @onclick="()=>Decidir(c.Id,false)">Rejeitar</button>}</article>}
}
@if(_aba=="Financeiro"&&_financeiro is not null){
<h2>@(Socio?"Minhas mensalidades e despesas":"Tesouraria do clube")</h2>
<div class="cards"><article>Em aberto<strong>@_financeiro.Aberto.ToString("C")</strong></article><article>Vencido<strong>@_financeiro.Vencido.ToString("C")</strong></article><article>Recebido<strong>@_financeiro.Recebido.ToString("C")</strong></article></div>
@if(Financeiro){<h3>Gerar mensalidades</h3><div class="form-grid"><label>Ano<input type="number" @bind="_ano" /></label><label>Mês<input type="number" min="1" max="12" @bind="_mes" /></label><label>Vencimento<input type="date" @bind="_vencimento" /></label></div><button disabled="@_ocupado" @onclick="GerarMensalidades">Gerar competência sem duplicar</button>}
<div class="tabela"><table><thead><tr><th>Titular / consumidor</th><th>Descrição</th><th>Valor</th><th>Vencimento</th><th>Situação</th><th>Ação</th></tr></thead><tbody>
@foreach(var c in _financeiro.Cobrancas){<tr><td>@c.Titular / @c.Consumidor</td><td>@c.Descricao</td><td>@c.Valor.ToString("C")</td><td>@c.Vencimento.ToString("dd/MM/yyyy")</td><td>@c.Situacao @(c.Vencida?"· vencida":"")</td><td>
@if(c.Situacao=="Aberta"){if(Financeiro){<button disabled="@_ocupado" @onclick="()=>Receber(c.Id)">Baixa manual</button>}<button disabled="@_ocupado" @onclick="()=>Boleto(c.Id)">Boleto</button>}
</td></tr>}</tbody></table></div><p>Boleto bancário exige integração ainda não configurada. A cobrança interna não é um boleto.</p>}
@if(_aba=="Solicitações"){
<h2>Solicitações e reclamações</h2>
@if(Socio){<div class="form-grid"><label>Tipo<select @bind="_tipoSolicitacao"><option value="Solicitacao">Solicitação</option><option value="Reclamacao">Reclamação</option></select></label><label>Título<input @bind="_tituloSolicitacao" /></label></div>
<label>Descrição<textarea @bind="_descricaoSolicitacao" maxlength="5000"></textarea></label><button disabled="@_ocupado" @onclick="Solicitar">Enviar à administração</button>}
@if(Gestor){<label>Resposta para o próximo andamento<input @bind="_resposta" /></label>}
@foreach(var s in _solicitacoes){<article><h3>@s.Titulo · @s.Status</h3><p>@s.Descricao</p>
@foreach(var h in s.Historico){<p>@Hora(h.Data) · @h.Status · @h.Mensagem</p>}
@if(Gestor&&s.Status is "Aberta" or "EmAnalise"){<button @onclick='()=>Andamento(s.Id,"EmAnalise")' disabled="@_ocupado">Em análise</button><button @onclick='()=>Andamento(s.Id,"Concluida")' disabled="@_ocupado">Concluir</button>}</article>}
}
@if(_aba=="Acessos"&&Gestor){
<h2>Contas e permissões do clube</h2><p>O super admin cria presidentes. O presidente pode liberar administradores e tesoureiros para o próprio clube.</p>
@foreach(var u in _usuarios){<p>@u.Nome · @u.Email · @u.Perfil</p>}
<div class="form-grid"><label>Nome<input @bind="_nomeUsuario" /></label><label>E-mail<input type="email" @bind="_emailUsuario" /></label><label>Senha inicial de teste<input type="password" @bind="_senhaUsuario" maxlength="256" /></label>
<label>Perfil<select @bind="_perfilUsuario">@foreach(var p in PerfisPermitidos){<option>@p</option>}</select></label>
@if(_perfilUsuario=="Socio"){<label>Associado ou dependente<select @bind="_pessoaUsuario"><option value="">Selecione</option>@foreach(var p in _pessoas){<option value="@p.Id">@p.Nome</option>}</select></label>}</div>
<button disabled="@_ocupado" @onclick="CriarUsuario">Criar e liberar acesso</button>
}
}

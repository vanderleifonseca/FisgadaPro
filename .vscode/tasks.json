{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clube360: compilar",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Clube360.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Clube360: verificar regras",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "tests/Clube360.Domain.Checks"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clube360: API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/Clube360.Api",
        "--launch-profile",
        "http"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clube360: painel",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/Clube360.Web",
        "--launch-profile",
        "http"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clube360: configurar contas locais",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "tools/Clube360.Setup"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clube360: verificar acessos",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "tests/Clube360.Access.Checks"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
